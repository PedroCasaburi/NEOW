# ============================================================
# INDUSTRIAL SAFETY MONITOR - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ============================================================
# NUNCA commitar o arquivo .env real no GitHub!
# Copie este arquivo para .env e preencha com seus valores reais.
# ============================================================

# ------------------------------------------------------------
# 1. SUPABASE — Conexão com Banco de Dados PostgreSQL Cloud
# ------------------------------------------------------------
# Obtenha em: https://supabase.com → Project Settings → API
# "Project URL" e "anon / public" key
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_COLE_SUA_CHAVE_ANON_PUBLICA_AQUI

# ------------------------------------------------------------
# 2. RESEND — Serviço de E-mail Transacional (OTP / Recuperação de Senha)
# ------------------------------------------------------------
# Obtenha gratuitamente em: https://resend.com/api-keys
# Sem esta chave o sistema opera em modo simulação (OTP exibido no terminal)
RESEND_API_KEY=re_SUA_CHAVE_RESEND_AQUI
RESEND_FROM_EMAIL=Industrial Safety Monitor <onboarding@resend.dev>

# ------------------------------------------------------------
# 3. API URL do Backend (opcional — só necessário para servidor local)
# ------------------------------------------------------------
# Em produção (Vercel) deixe VAZIO ou aponte para a URL do deploy
# Em desenvolvimento local coloque o IP da sua máquina ou ngrok URL
VITE_API_URL=
