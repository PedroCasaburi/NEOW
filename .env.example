# ============================================================
# INDUSTRIAL SAFETY MONITOR - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ============================================================

# 1. Conexão com o Supabase (PostgreSQL Cloud)
# Obtenha no painel do Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# 2. URL do backend local (server.ts) ou túnel ngrok (opcional)
# Se estiver rodando localmente na mesma máquina, deixe vazio
VITE_API_URL=http://SEU-IP-LOCAL:3000

# 3. Integração de E-mail para Recuperação de Senha (Resend API)
# Obtenha uma chave gratuita em https://resend.com/api-keys
# Sem esta chave o sistema opera em modo simulação (código exibido no terminal)
RESEND_API_KEY=re_sua_chave_aqui
RESEND_FROM_EMAIL=Industrial Safety Monitor <onboarding@resend.dev>
